name: Build bottom panel APK

on:
  push:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.4'

      - name: Create project files
        run: |
          mkdir -p panel/app/src/main/java/com/example/panel
          cd panel

          cat > settings.gradle <<'EOF'
          pluginManagement {
              repositories { google(); mavenCentral(); gradlePluginPortal() }
          }
          dependencyResolutionManagement {
              repositories { google(); mavenCentral() }
          }
          rootProject.name = "Panel"
          include ':app'
          EOF

          cat > build.gradle <<'EOF'
          plugins {
              id 'com.android.application' version '8.2.2' apply false
          }
          EOF

          cat > app/build.gradle <<'EOF'
          plugins {
              id 'com.android.application'
          }
          android {
              namespace 'com.example.panel'
              compileSdk 34
              defaultConfig {
                  applicationId 'com.example.panel'
                  minSdk 29
                  targetSdk 29
                  versionCode 1
                  versionName '1.0'
              }
              compileOptions {
                  sourceCompatibility JavaVersion.VERSION_17
                  targetCompatibility JavaVersion.VERSION_17
              }
          }
          EOF

          cat > app/src/main/AndroidManifest.xml <<'EOF'
          <?xml version="1.0" encoding="utf-8"?>
          <manifest xmlns:android="http://schemas.android.com/apk/res/android">
              <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
              <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
              <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
              <application
                  android:label="Bottom Panel"
                  android:theme="@android:style/Theme.Material.Light.NoActionBar">
                  <activity
                      android:name=".MainActivity"
                      android:exported="true">
                      <intent-filter>
                          <action android:name="android.intent.action.MAIN" />
                          <category android:name="android.intent.category.LAUNCHER" />
                      </intent-filter>
                  </activity>
                  <activity
                      android:name=".AppsActivity"
                      android:exported="false"
                      android:theme="@android:style/Theme.Material.NoActionBar" />
                  <service
                      android:name=".PanelService"
                      android:exported="false" />
                  <receiver
                      android:name=".BootReceiver"
                      android:exported="true">
                      <intent-filter>
                          <action android:name="android.intent.action.BOOT_COMPLETED" />
                          <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                      </intent-filter>
                  </receiver>
              </application>
          </manifest>
          EOF

          cat > app/src/main/java/com/example/panel/BootReceiver.java <<'EOF'
          package com.example.panel;

          import android.content.BroadcastReceiver;
          import android.content.Context;
          import android.content.Intent;
          import android.content.SharedPreferences;
          import android.provider.Settings;

          public class BootReceiver extends BroadcastReceiver {
              @Override
              public void onReceive(Context c, Intent i) {
                  SharedPreferences p = c.getSharedPreferences("p", 0);
                  if (!p.getBoolean("boot", true)) return;
                  if (!Settings.canDrawOverlays(c)) return;
                  c.startForegroundService(new Intent(c, PanelService.class));
              }
          }
          EOF

          cat > app/src/main/java/com/example/panel/PanelService.java <<'EOF'
          package com.example.panel;

          import android.app.Notification;
          import android.app.NotificationChannel;
          import android.app.NotificationManager;
          import android.app.Service;
          import android.content.Intent;
          import android.content.SharedPreferences;
          import android.graphics.Color;
          import android.graphics.PixelFormat;
          import android.graphics.Typeface;
          import android.graphics.drawable.GradientDrawable;
          import android.net.Uri;
          import android.os.IBinder;
          import android.provider.Settings;
          import android.util.DisplayMetrics;
          import android.view.Gravity;
          import android.view.View;
          import android.view.ViewGroup;
          import android.view.WindowManager;
          import android.widget.FrameLayout;
          import android.widget.LinearLayout;
          import android.widget.TextClock;
          import android.widget.TextView;
          import android.widget.Toast;

          public class PanelService extends Service {
              private static final int W = ViewGroup.LayoutParams.WRAP_CONTENT;
              private static final int M = ViewGroup.LayoutParams.MATCH_PARENT;
              private WindowManager wm;
              private View panel;
              private View handle;
              private boolean hidden = false;
              private float dens = 1f;

              @Override
              public IBinder onBind(Intent i) {
                  return null;
              }

              @Override
              public int onStartCommand(Intent i, int f, int id) {
                  NotificationManager nm = (NotificationManager) getSystemService(NOTIFICATION_SERVICE);
                  nm.createNotificationChannel(new NotificationChannel("panel", "Bottom panel",
                          NotificationManager.IMPORTANCE_MIN));
                  Notification n = new Notification.Builder(this, "panel")
                          .setContentTitle("Bottom panel is running")
                          .setSmallIcon(android.R.drawable.ic_dialog_info)
                          .build();
                  startForeground(1, n);
                  if (!Settings.canDrawOverlays(this)) {
                      stopSelf();
                      return START_NOT_STICKY;
                  }
                  wm = (WindowManager) getSystemService(WINDOW_SERVICE);
                  dens = getResources().getDisplayMetrics().density;
                  hidden = false;
                  build();
                  return START_STICKY;
              }

              @Override
              public void onDestroy() {
                  clear();
                  super.onDestroy();
              }

              private int px(float dp) {
                  return Math.round(dp * dens);
              }

              private void remove(View v) {
                  if (v != null && wm != null) {
                      try {
                          wm.removeView(v);
                      } catch (Exception ignored) {
                      }
                  }
              }

              private void clear() {
                  remove(panel);
                  remove(handle);
                  panel = null;
                  handle = null;
              }

              private WindowManager.LayoutParams lp(int w, int h, int gravity, int x, int y) {
                  WindowManager.LayoutParams l = new WindowManager.LayoutParams(w, h,
                          WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
                          WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
                                  | WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL
                                  | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
                                  | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
                          PixelFormat.OPAQUE);
                  l.gravity = gravity;
                  l.x = x;
                  l.y = y;
                  return l;
              }

              private void build() {
                  clear();
                  SharedPreferences p = getSharedPreferences("p", 0);
                  int hDp = p.getInt("height", 170);
                  int sDp = p.getInt("side", 200);
                  DisplayMetrics real = new DisplayMetrics();
                  wm.getDefaultDisplay().getRealMetrics(real);
                  if (hidden) {
                      addHandle(real);
                  } else {
                      addPanel(real, hDp, sDp);
                  }
              }

              private void addHandle(DisplayMetrics real) {
                  TextView t = new TextView(this);
                  t.setText("Show panel");
                  t.setTextColor(Color.WHITE);
                  t.setTextSize(16);
                  t.setGravity(Gravity.CENTER);
                  t.setBackgroundColor(Color.rgb(60, 66, 76));
                  t.setOnClickListener(v -> {
                      hidden = false;
                      build();
                  });
                  int h = px(44);
                  try {
                      wm.addView(t, lp(px(150), h, Gravity.TOP | Gravity.CENTER_HORIZONTAL, 0, real.heightPixels - h));
                      handle = t;
                  } catch (Exception e) {
                      Toast.makeText(this, "Cannot show handle: " + e, Toast.LENGTH_LONG).show();
                  }
              }

              private void addPanel(DisplayMetrics real, int hDp, int sDp) {
                  int h = px(hDp);
                  int size = px(Math.max(40, Math.min(100, hDp - 20)));
                  FrameLayout root = new FrameLayout(this);
                  root.setBackgroundColor(Color.rgb(16, 20, 24));
                  root.setPadding(px(sDp), 0, px(sDp), 0);

                  LinearLayout left = row();
                  left.addView(tile("Home", Color.rgb(240, 110, 60), size, v -> goHome()));
                  left.addView(tile("Apps", Color.rgb(40, 110, 230), size,
                          v -> go(new Intent(this, AppsActivity.class))));
                  root.addView(left, new FrameLayout.LayoutParams(W, W, Gravity.START | Gravity.CENTER_VERTICAL));

                  LinearLayout clock = new LinearLayout(this);
                  clock.setOrientation(LinearLayout.VERTICAL);
                  clock.setGravity(Gravity.CENTER_HORIZONTAL);
                  TextClock time = new TextClock(this);
                  time.setFormat12Hour("h:mm");
                  time.setFormat24Hour("HH:mm");
                  time.setTextColor(Color.WHITE);
                  time.setTextSize(44);
                  time.setTypeface(Typeface.DEFAULT_BOLD);
                  time.setGravity(Gravity.CENTER);
                  TextClock date = new TextClock(this);
                  date.setFormat12Hour("EEE, d MMM yyyy");
                  date.setFormat24Hour("EEE, d MMM yyyy");
                  date.setTextColor(Color.rgb(180, 190, 200));
                  date.setTextSize(16);
                  date.setGravity(Gravity.CENTER);
                  clock.addView(time, new LinearLayout.LayoutParams(W, W));
                  clock.addView(date, new LinearLayout.LayoutParams(W, W));
                  root.addView(clock, new FrameLayout.LayoutParams(W, W, Gravity.CENTER));

                  LinearLayout right = row();
                  right.addView(tile("Maps", Color.rgb(0, 150, 160), size, v -> openMaps()));
                  right.addView(tile("Phone", Color.rgb(50, 180, 70), size,
                          v -> go(new Intent(Intent.ACTION_DIAL))));
                  right.addView(tile("Hide", Color.rgb(90, 98, 110), size, v -> {
                      hidden = true;
                      build();
                  }));
                  root.addView(right, new FrameLayout.LayoutParams(W, W, Gravity.END | Gravity.CENTER_VERTICAL));

                  try {
                      wm.addView(root, lp(M, h, Gravity.TOP | Gravity.LEFT, 0, real.heightPixels - h));
                      panel = root;
                  } catch (Exception e) {
                      Toast.makeText(this, "Cannot show panel: " + e, Toast.LENGTH_LONG).show();
                  }
              }

              private LinearLayout row() {
                  LinearLayout l = new LinearLayout(this);
                  l.setOrientation(LinearLayout.HORIZONTAL);
                  l.setGravity(Gravity.CENTER_VERTICAL);
                  return l;
              }

              private TextView tile(String label, int color, int size, View.OnClickListener l) {
                  TextView t = new TextView(this);
                  t.setText(label);
                  t.setTextColor(Color.WHITE);
                  t.setTextSize(17);
                  t.setTypeface(Typeface.DEFAULT_BOLD);
                  t.setGravity(Gravity.CENTER);
                  GradientDrawable g = new GradientDrawable();
                  g.setColor(color);
                  g.setCornerRadius(px(16));
                  t.setBackground(g);
                  LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(size, size);
                  p.setMargins(px(6), 0, px(6), 0);
                  t.setLayoutParams(p);
                  t.setOnClickListener(l);
                  return t;
              }

              private void go(Intent i) {
                  try {
                      i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
                      startActivity(i);
                  } catch (Exception e) {
                      Toast.makeText(this, "Cannot open: " + e.getMessage(), Toast.LENGTH_LONG).show();
                  }
              }

              private void goHome() {
                  Intent h = new Intent(Intent.ACTION_MAIN);
                  h.addCategory(Intent.CATEGORY_HOME);
                  go(h);
              }

              private void openMaps() {
                  Intent m = getPackageManager().getLaunchIntentForPackage("com.google.android.apps.maps");
                  if (m == null) {
                      m = new Intent(Intent.ACTION_VIEW, Uri.parse("geo:0,0?q="));
                  }
                  go(m);
              }
          }
          EOF

          cat > app/src/main/java/com/example/panel/AppsActivity.java <<'EOF'
          package com.example.panel;

          import android.app.Activity;
          import android.content.Intent;
          import android.content.pm.PackageManager;
          import android.content.pm.ResolveInfo;
          import android.graphics.Color;
          import android.os.Bundle;
          import android.view.Gravity;
          import android.view.View;
          import android.view.ViewGroup;
          import android.widget.BaseAdapter;
          import android.widget.GridView;
          import android.widget.ImageView;
          import android.widget.LinearLayout;
          import android.widget.TextView;
          import android.widget.Toast;
          import java.util.Collections;
          import java.util.List;

          public class AppsActivity extends Activity {
              @Override
              protected void onCreate(Bundle b) {
                  super.onCreate(b);
                  final PackageManager pm = getPackageManager();
                  Intent mi = new Intent(Intent.ACTION_MAIN);
                  mi.addCategory(Intent.CATEGORY_LAUNCHER);
                  final List<ResolveInfo> apps = pm.queryIntentActivities(mi, 0);
                  Collections.sort(apps, new ResolveInfo.DisplayNameComparator(pm));
                  final float d = getResources().getDisplayMetrics().density;

                  GridView g = new GridView(this);
                  g.setBackgroundColor(Color.rgb(16, 20, 24));
                  g.setNumColumns(6);
                  int pad = (int) (16 * d);
                  g.setPadding(pad, pad, pad, pad);
                  g.setVerticalSpacing((int) (12 * d));
                  g.setAdapter(new BaseAdapter() {
                      @Override
                      public int getCount() {
                          return apps.size();
                      }

                      @Override
                      public Object getItem(int i) {
                          return apps.get(i);
                      }

                      @Override
                      public long getItemId(int i) {
                          return i;
                      }

                      @Override
                      public View getView(int i, View c, ViewGroup parent) {
                          ResolveInfo ri = apps.get(i);
                          LinearLayout l = new LinearLayout(AppsActivity.this);
                          l.setOrientation(LinearLayout.VERTICAL);
                          l.setGravity(Gravity.CENTER_HORIZONTAL);
                          ImageView iv = new ImageView(AppsActivity.this);
                          iv.setImageDrawable(ri.loadIcon(pm));
                          l.addView(iv, new LinearLayout.LayoutParams((int) (56 * d), (int) (56 * d)));
                          TextView t = new TextView(AppsActivity.this);
                          t.setText(ri.loadLabel(pm));
                          t.setTextColor(Color.WHITE);
                          t.setTextSize(12);
                          t.setSingleLine(true);
                          t.setGravity(Gravity.CENTER);
                          l.addView(t, new LinearLayout.LayoutParams(
                                  ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT));
                          return l;
                      }
                  });
                  g.setOnItemClickListener((parent, v, i, id) -> {
                      ResolveInfo ri = apps.get(i);
                      Intent li = new Intent(Intent.ACTION_MAIN);
                      li.addCategory(Intent.CATEGORY_LAUNCHER);
                      li.setClassName(ri.activityInfo.packageName, ri.activityInfo.name);
                      li.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
                      try {
                          startActivity(li);
                      } catch (Exception e) {
                          Toast.makeText(this, "Cannot open: " + e.getMessage(), Toast.LENGTH_LONG).show();
                      }
                      finish();
                  });
                  setContentView(g);
              }
          }
          EOF

          cat > app/src/main/java/com/example/panel/MainActivity.java <<'EOF'
          package com.example.panel;

          import android.app.Activity;
          import android.content.ActivityNotFoundException;
          import android.content.Intent;
          import android.content.SharedPreferences;
          import android.net.Uri;
          import android.os.Bundle;
          import android.provider.Settings;
          import android.view.View;
          import android.widget.Button;
          import android.widget.LinearLayout;
          import android.widget.ScrollView;
          import android.widget.TextView;
          import android.widget.Toast;

          public class MainActivity extends Activity {
              private SharedPreferences p;
              private TextView status;
              private TextView hTv;
              private TextView sTv;
              private Button bootBtn;

              @Override
              protected void onCreate(Bundle b) {
                  super.onCreate(b);
                  p = getSharedPreferences("p", 0);
                  ScrollView sv = new ScrollView(this);
                  LinearLayout root = new LinearLayout(this);
                  root.setOrientation(LinearLayout.VERTICAL);
                  root.setPadding(24, 24, 24, 24);

                  status = new TextView(this);
                  status.setTextSize(15);
                  root.addView(status);

                  root.addView(btn("1) Grant overlay permission", v -> askOverlay()));
                  root.addView(btn("2) Start / refresh panel", v -> startPanel()));
                  root.addView(btn("Stop panel", v -> stopService(new Intent(this, PanelService.class))));

                  hTv = new TextView(this);
                  hTv.setTextSize(16);
                  hTv.setGravity(android.view.Gravity.CENTER);
                  root.addView(stepper(hTv, "height", 170, 60, 250, 10));

                  sTv = new TextView(this);
                  sTv.setTextSize(16);
                  sTv.setGravity(android.view.Gravity.CENTER);
                  root.addView(stepper(sTv, "side", 200, 0, 400, 20));

                  bootBtn = btn("", v -> {
                      p.edit().putBoolean("boot", !p.getBoolean("boot", true)).apply();
                      refresh();
                  });
                  root.addView(bootBtn);
                  root.addView(btn("Open app grid", v -> startActivity(new Intent(this, AppsActivity.class))));

                  sv.addView(root);
                  setContentView(sv);
              }

              @Override
              protected void onResume() {
                  super.onResume();
                  refresh();
              }

              private Button btn(String t, View.OnClickListener l) {
                  Button x = new Button(this);
                  x.setText(t);
                  x.setAllCaps(false);
                  x.setOnClickListener(l);
                  return x;
              }

              private LinearLayout stepper(TextView label, String key, int def, int min, int max, int step) {
                  LinearLayout r = new LinearLayout(this);
                  r.setOrientation(LinearLayout.HORIZONTAL);
                  r.addView(btn("-", v -> change(key, def, -step, min, max)));
                  r.addView(label, new LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f));
                  r.addView(btn("+", v -> change(key, def, step, min, max)));
                  return r;
              }

              private void change(String key, int def, int delta, int min, int max) {
                  int v = Math.max(min, Math.min(max, p.getInt(key, def) + delta));
                  p.edit().putInt(key, v).apply();
                  refresh();
                  if (Settings.canDrawOverlays(this)) {
                      startPanel();
                  }
              }

              private void refresh() {
                  status.setText("Overlay permission: " + Settings.canDrawOverlays(this));
                  hTv.setText("Panel height: " + p.getInt("height", 170) + " dp");
                  sTv.setText("Side margin (knob clearance): " + p.getInt("side", 200) + " dp");
                  bootBtn.setText("Auto-start on boot: " + (p.getBoolean("boot", true) ? "ON" : "OFF"));
              }

              private void askOverlay() {
                  try {
                      startActivity(new Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION,
                              Uri.parse("package:" + getPackageName())));
                  } catch (ActivityNotFoundException e) {
                      Toast.makeText(this,
                              "No overlay settings screen. Try Settings > Apps > Bottom Panel > Display over other apps",
                              Toast.LENGTH_LONG).show();
                  }
              }

              private void startPanel() {
                  if (!Settings.canDrawOverlays(this)) {
                      Toast.makeText(this, "Grant overlay permission first (button 1)", Toast.LENGTH_LONG).show();
                      return;
                  }
                  startForegroundService(new Intent(this, PanelService.class));
              }
          }
          EOF

      - name: Build APK
        working-directory: panel
        run: gradle assembleDebug --no-daemon

      - name: Publish APK as a release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: panel-${{ github.run_number }}
          name: Bottom Panel APK ${{ github.run_number }}
          files: panel/app/build/outputs/apk/debug/app-debug.apk
